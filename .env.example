# 复制本文件为 .env 并填入真实连接信息
# 格式：postgres://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgres://username:password@localhost:5432/database

# 管理员账号（管理后台 /admin 登录用）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# JWT 签名密钥，可用 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 生成
JWT_SECRET=replace-with-random-secret

# 登录态有效期（支持 Nd 天 / Nh 小时 / Nm 分钟，无后缀按天，如 7d、12h、30m）
ADMIN_TOKEN_TTL=7d
USER_TOKEN_TTL=7d

# 用户批量投稿冷却时间（成功投稿后再次投稿需等待，支持 Nd/Nh/Nm，默认 1h）
USER_BATCH_COOLDOWN=1h

# HTTPS 部署时设为 true，登录 cookie 将仅通过 HTTPS 传输（本地 http 调试保持 false）
COOKIE_SECURE=false
