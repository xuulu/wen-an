# 复制本文件为 .env 并填入真实连接信息
# 格式：postgres://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgres://username:password@localhost:5432/database

# 管理员账号（管理后台 /admin 登录用）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# JWT 签名密钥，可用 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 生成
JWT_SECRET=replace-with-random-secret

# 登录态有效期（支持 Nd 天 / Nh 小时 / Nm 分钟，无后缀按天，如 7d、12h、30m）
ADMIN_TOKEN_TTL=7d
USER_TOKEN_TTL=7d

# 注意：用户批量投稿冷却时间已由后台「站点设置 → 审核规则 → 批量投稿冷却时间」接管，
# 无需（也不应）在 .env 中配置。

# HTTPS 部署时设为 true，登录 cookie 将仅通过 HTTPS 传输（本地 http 调试保持 false）
COOKIE_SECURE=false

# 站点对外域名（完整 URL，不含尾部斜杠）。用于 sitemap / robots / SEO metadata。
# 也可在后台「站点设置 → 站点域名」配置；本变量是部署兜底（优先读后台配置）。
# 未配置时 sitemap/robots 不输出域名（不输出 localhost）。
# SITE_URL=https://example.com

# —— 全局限流（中间件，Edge）——
# 在 https://console.upstash.com 创建 Redis 数据库后，把 REST URL 与 Token 填到这里。
# 未配置时中间件自动放行，应用层（内存）限流仍然生效；生产环境强烈建议配置。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# —— 定时任务（回收站物理清理 / 卡住的删除任务续跑）——
# /api/cron/deletion-jobs 需带 Authorization: Bearer <CRON_SECRET>。
# 可用 node -e "console.log(require('crypto').randomBytes(24).toString('hex'))" 生成。
# 配好后用 Linux crontab 每天调用一次（见该路由注释）。
CRON_SECRET=
